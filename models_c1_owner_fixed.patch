+def init_modus_x_c1_lm(key: jax.Array, cfg: ModelConfig) -> dict:
+    """Initialize C1 with the MemoryFeedbackArchive tree schema."""
+    keys = random.split(key, cfg.n_layers + 2)
+    layers = [init_modus_x_c1_layer(keys[i], cfg) for i in range(cfg.n_layers)]
+    return {
+        "embed": init_embed(keys[-2], cfg),
+        "layers": jax.tree_util.tree_map(lambda *xs: jnp.stack(xs), *layers),
+        "head": init_lm_head(keys[-1], cfg.embed_dim, cfg),
+    }
