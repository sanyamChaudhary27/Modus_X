+def modus_x_c1_lm_fwd(p: dict, x_ids: jax.Array, cfg: ModelConfig) -> jax.Array:
+    x = p["embed"][x_ids]
+    def scan_layer(x_in, layer):
+        return x_in + modus_x_c1_layer_fwd(layer, x_in), None
+    x, _ = lax.scan(scan_layer, x, p["layers"])
+    return lm_head_fwd(p["head"], x)
